{
  "slug": "guide/http/interceptors",
  "title": "Interceptors",
  "description": "Learn how to use functional interceptors in Angular: authentication, logging, retry patterns, and request mutation.",
  "source": "https://angular.dev/guide/http/interceptors",
  "status": "reviewed",
  "blocks": [
    {
      "type": "paragraph",
      "text": "<code>HttpClient</code> supports a form of middleware known as <strong>interceptors</strong>. Interceptors allow common patterns around retrying, caching, logging, and authentication to be abstracted away from individual requests."
    },
    {
      "type": "heading",
      "level": 2,
      "id": "defining-functional-interceptors",
      "text": "Defining functional interceptors"
    },
    {
      "type": "paragraph",
      "text": "The recommended way to define interceptors in modern Angular is using functions of type <code>HttpInterceptorFn</code>:"
    },
    {
      "type": "code",
      "file": "logging.interceptor.ts",
      "lang": "ts",
      "code": [
        "import { HttpInterceptorFn } from '@angular/common/http';",
        "",
        "export const loggingInterceptor: HttpInterceptorFn = (req, next) => {",
        "  console.log(`Request URL: ${req.url}`);",
        "  return next(req);",
        "};"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "mutating-requests",
      "text": "Mutating requests (e.g., adding Auth tokens)"
    },
    {
      "type": "paragraph",
      "text": "Because <code>HttpRequest</code> instances are immutable, you must use <code>req.clone()</code> to add headers or alter request properties:"
    },
    {
      "type": "code",
      "file": "auth.interceptor.ts",
      "lang": "ts",
      "code": [
        "import { HttpInterceptorFn } from '@angular/common/http';",
        "import { inject } from '@angular/core';",
        "import { AuthService } from './auth.service';",
        "",
        "export const authInterceptor: HttpInterceptorFn = (req, next) => {",
        "  const authService = inject(AuthService);",
        "  const authToken = authService.getAuthToken();",
        "",
        "  // Clone the request and add the authorization header",
        "  const authReq = req.clone({",
        "    setHeaders: {",
        "      Authorization: `Bearer ${authToken}`",
        "    }",
        "  });",
        "",
        "  return next(authReq);",
        "};"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "registering-interceptors",
      "text": "Registering interceptors"
    },
    {
      "type": "paragraph",
      "text": "Register interceptors inside <code>withInterceptors([...])</code> within <code>provideHttpClient()</code>:"
    },
    {
      "type": "code",
      "file": "app.config.ts",
      "lang": "ts",
      "code": [
        "import { provideHttpClient, withInterceptors } from '@angular/common/http';",
        "import { authInterceptor } from './auth.interceptor';",
        "import { loggingInterceptor } from './logging.interceptor';",
        "",
        "export const appConfig: ApplicationConfig = {",
        "  providers: [",
        "    provideHttpClient(",
        "      withInterceptors([authInterceptor, loggingInterceptor])",
        "    ),",
        "  ],",
        "};"
      ]
    }
  ]
}