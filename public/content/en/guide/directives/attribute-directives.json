{
  "slug": "guide/directives/attribute-directives",
  "title": "Attribute Directives",
  "description": "Learn how to build attribute directives that modify the appearance or behavior of HTML elements and components.",
  "source": "https://angular.dev/guide/directives/attribute-directives",
  "status": "reviewed",
  "blocks": [
    {
      "type": "paragraph",
      "text": "An <strong>Attribute directive</strong> changes the appearance or behavior of a DOM element. This guide shows how to manage user events using <code>@HostListener</code> and pass values into directives using <code>@Input</code>."
    },
    {
      "type": "heading",
      "level": 2,
      "id": "handling-user-events",
      "text": "Handling user events"
    },
    {
      "type": "paragraph",
      "text": "Use the <code>@HostListener</code> decorator to subscribe to events of the DOM element that hosts the directive:"
    },
    {
      "type": "code",
      "file": "highlight.directive.ts",
      "lang": "ts",
      "code": [
        "import { Directive, ElementRef, HostListener, Input, inject } from '@angular/core';",
        "",
        "@Directive({",
        "  selector: '[appHighlight]',",
        "  standalone: true,",
        "})",
        "export class HighlightDirective {",
        "  private el = inject(ElementRef);",
        "",
        "  @Input() appHighlight = '';",
        "  @Input() defaultColor = '';",
        "",
        "  @HostListener('mouseenter')",
        "  onMouseEnter() {",
        "    this.highlight(this.appHighlight || this.defaultColor || 'red');",
        "  }",
        "",
        "  @HostListener('mouseleave')",
        "  onMouseLeave() {",
        "    this.highlight('');",
        "  }",
        "",
        "  private highlight(color: string) {",
        "    this.el.nativeElement.style.backgroundColor = color;",
        "  }",
        "}"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "id": "applying-the-directive",
      "text": "Applying the attribute directive"
    },
    {
      "type": "paragraph",
      "text": "Add the directive to your component imports and bind to the selector in your template:"
    },
    {
      "type": "code",
      "file": "app.component.html",
      "lang": "html",
      "code": [
        "<p [appHighlight]=\"color\" defaultColor=\"violet\">",
        "  Highlight me with mouse hovering!",
        "</p>"
      ]
    }
  ]
}